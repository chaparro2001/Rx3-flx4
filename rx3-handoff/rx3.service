[Unit]
Description=XDJ-RX3 firmware player (chroot) with DDJ-FLX4 bridge
After=network-online.target sound.target local-fs.target systemd-udev-settle.service
Wants=network-online.target sound.target

[Service]
Type=forking
ExecStart=/home/rx3/rx3-handoff/rx3-start.sh
ExecStop=/home/rx3/rx3-handoff/rx3-stop.sh
TimeoutStopSec=20
TimeoutStartSec=120
RemainAfterExit=yes
LimitRTPRIO=99
LimitMEMLOCK=infinity

[Install]
WantedBy=multi-user.target
