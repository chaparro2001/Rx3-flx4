# Hot-plugged USB storage partitions are presented to the RX3 player as USB1 via a copy-on-write overlay.
ACTION=="add", SUBSYSTEM=="block", ENV{ID_BUS}=="usb", ENV{DEVTYPE}=="partition", ENV{ID_FS_TYPE}!="", RUN+="/bin/sh -c '/usr/bin/systemd-run --no-block @RX3_HOME@/usb-hotplug.sh add %E{DEVNAME}'"
ACTION=="remove", SUBSYSTEM=="block", ENV{DEVTYPE}=="partition", RUN+="/bin/sh -c '/usr/bin/systemd-run --no-block @RX3_HOME@/usb-hotplug.sh remove %E{DEVNAME}'"
